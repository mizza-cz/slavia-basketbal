{% extends "@components/base/base.twig" %} {% set title = "03.0_archive" %} {%
block main %}
<div class="bg-subpage">
  {% include "@components/header/header.twig" %}
  <div class="pt-12 pb-8">
    <div class="container-full">
      <h1 class="h1 text-white">ARCHIV ČLÁNKŮ</h1>
    </div>
  </div>
</div>

<main class="main" aria-label="Hlavní obsah">
  <div class="mt-4 mb-lg-15 mb-10">
    <div class="container">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item">
            <a href="#">
              <img
                class="object-fit-contain"
                width="20"
                height="19"
                src="images/ico/logo-primary.svg"
                alt="home"
              />
            </a>
          </li>

          <li class="breadcrumb-item active" aria-current="page">Články</li>
        </ol>
      </nav>

      <form action="" class="filterMenu">
        <div
          class="d-flex align-items-center justify-content-between flex-wrap gap-6"
        >
          <div class="d-flex align-items-center gap-lg-8 gap-6 flex-wrap">
            <div
              class="d-flex gap-4 align-items-center flex-md-nowrap flex-wrap w-md-auto w-100"
            >
              <label for="month">Měsíc:</label>
              <select class="js-select" name="month" id="month">
                <option value="1">Leden</option>
                <option value="1">Leden</option>
                <option value="1">Leden</option>
              </select>
            </div>
            <div
              class="d-flex gap-4 align-items-center flex-md-nowrap flex-wrap w-md-auto w-100"
            >
              <label for="category">Kategorie:</label>
              <select class="js-select" name="category" id="category">
                <option value="1">Zápasy</option>
                <option value="1">Kategorie 1</option>
                <option value="1">Kategorie 1</option>
                <option value="1">Kategorie 1</option>
              </select>
            </div>
          </div>
          <div
            class="d-flex gap-4 align-items-center flex-md-nowrap flex-wrap w-md-auto w-100"
          >
            <label for="searchInput">Hledat:</label>
            <div class="filterMenu__input">
              <input type="search" name="searchInput" id="searchInput" />
              <button type="submit" class="filterMenu__input-btn">
                <img
                  src="images/ico/search.svg"
                  alt="ico"
                  width="24"
                  height="24"
                />
              </button>
            </div>
          </div>
        </div>
      </form>

      {% include "@components/archive-section/archive-section.twig" %}
      <nav class="pagination-wrap" aria-label="Navigace stránek">
        <ul class="pagination">
          <li class="page-item disabled">
            <a
              class="page-link page-link--prev"
              href="#"
              tabindex="-1"
              aria-disabled="true"
              aria-label="Předchozí stránka"
            >
              {% include "@images/left-arrow.svg" %}
            </a>
          </li>

          <li class="page-item active" aria-current="page">
            <a class="page-link" href="#">1</a>
          </li>

          <li class="page-item">
            <a class="page-link" href="#">2</a>
          </li>

          <li class="page-item">
            <a class="page-link" href="#">3</a>
          </li>

          <li class="page-item page-item--dots" aria-hidden="true">
            <span class="page-link">…</span>
          </li>

          <li class="page-item">
            <a class="page-link" href="#">9</a>
          </li>

          <li class="page-item">
            <a
              class="page-link page-link--next"
              href="#"
              aria-label="Další stránka"
            >
              {% include "@images/right-arrow.svg" %}
            </a>
          </li>
        </ul>

        <div class="text-md mt-6 text-center">Zobrazeno 1-12 z 76 článků</div>
      </nav>
    </div>
  </div>
  {% include "@components/partners/partners.twig" %}
</main>

{% endblock %}
