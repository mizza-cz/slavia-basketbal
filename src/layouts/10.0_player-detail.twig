{% extends "@components/base/base.twig" %} {% set title = "10.0_player-detail"
%} {% block main %}
<div class="bg-player">
  {% include "@components/header/header.twig" %} {% include
  "@components/playerHero/playerHero.twig" %}
</div>

<main class="main" aria-label="Hlavní obsah">
  <div class="playerDetail">
    <div class="container">
      <div class="playerDetail__layout">
        <div class="playerDetail__sidebar-space"></div>

        <div class="playerDetail__content">
          <div class="mb-10">
            <h2 class="h3 mb-6">O HRÁČI</h2>
            <p class="text-base">
              Lorem ipsum dolor sit amet, consectetuer adipiscing elit.
              Phasellus hendrerit. Pellentesque aliquet nibh nec urna. In nisi
              neque, aliquet vel, dapibus id, mattis vel, nisi. Sed pretium,
              ligula sollicitudin laoreet viverra, tortor libero sodales leo,
              eget blandit nunc tortor eu nibh. Nullam mollis. Ut justo.
              Suspendisse potenti.
            </p>
          </div>

          <h3 class="h3 mb-6">FOTOGALERIE</h3>
          <div class="row g-lg-6 g-5">
            {% for i in 1..6 %}
            <div class="col-sm-4 col-6">
              <a
                data-source="/slavia-basketbal/build/ajax-gallery.json"
                data-gallery-id="1"
                href="#"
                class="galleryItem"
              >
                <img
                  srcset="images/content/post.png"
                  loading="lazy"
                  alt="post"
                />
              </a>
            </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>

  {% include "@components/partners/partners.twig" %}
</main>
{% endblock %}
