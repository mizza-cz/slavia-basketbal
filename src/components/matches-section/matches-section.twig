<section class="matches-section">
  <div class="menuTabs mb-8">
    <ul class="nav nav-tabs">
      <li>
        <a class="active px-md-5 px-3" href="#allGames"> Vše </a>
      </li>
      <li>
        <a class="px-md-5 px-3" href="#beforeGames">Nadcházející</a>
      </li>
      <li>
        <a class="px-md-5 px-3" href="#afterGames">Odehrané</a>
      </li>
      <li>
        <a class="px-md-5 px-3" href="#homeGames">Doma </a>
      </li>
      <li>
        <a class="px-md-5 px-3" href="#outsideGames">Venku </a>
      </li>
    </ul>

    <div
      class="d-flex gap-4 align-items-center flex-md-nowrap flex-wrap w-md-auto w-100"
    >
      <select class="js-select" name="category" id="category">
        <option value="1">NBL 2026/27</option>
        <option value="1">NBL 2026/27</option>
        <option value="1">NBL 2026/27</option>
        <option value="1">NBL 2026/27</option>
        <option value="1">NBL 2026/27</option>
      </select>
    </div>
  </div>
  <div class="bg-white py-1 px-5">
    <!-- Odehraný zápas -->
    <div class="matchItem">
      <div class="matchItem__teams">
        <img
          class="matchItem__team-logo"
          src="images/content/slavia.png"
          alt="Slavia Praha"
        />
        <img
          class="matchItem__team-logo"
          src="images/content/pard.png"
          alt="BK KVIS Pardubice"
        />
      </div>

      <div class="matchItem__info">
        <div class="text-base mb-2">
          <strong>Slavia Praha</strong> – BK Pardubice
        </div>
        <div class="text-md">
          <div>1. kolo | Základní část</div>
          <div class="fw-bold">SOB 24. 10. 2026 18:00</div>
          <div>Sportovní hala Královka</div>
        </div>
      </div>

      <a href="#" class="matchItem__competition">
        <img src="images/content/maxa-nbl.png" alt="Maxa NBL" />
      </a>

      <div class="matchItem__score">
        <div class="matchItem__score-value">97 : 82</div>

        <a
          class="matchItem__stream"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src="images/content/tvcom.png" alt="TVCOM live" />
        </a>
      </div>

      <div class="matchItem__buttons">
        <a href="#" class="button-dark-outline">ČLÁNEK</a>
      </div>
    </div>
    {% for i in 1..6 %}
    <div class="matchItem">
      <div class="matchItem__teams">
        <img
          class="matchItem__team-logo"
          src="images/content/slavia.png"
          alt="Slavia Praha"
        />
        <img
          class="matchItem__team-logo"
          src="images/content/pard.png"
          alt="BK KVIS Pardubice"
        />
      </div>

      <div class="matchItem__info">
        <div class="text-base mb-2">
          <strong>Slavia Praha</strong> – BK Pardubice
        </div>
        <div class="text-md">
          <div>1. kolo | Základní část</div>
          <div class="fw-bold">SOB 24. 10. 2026 18:00</div>
          <div>Sportovní hala Královka</div>
        </div>
      </div>

      <a href="#" class="matchItem__competition">
        <img src="images/content/maxa-nbl.png" alt="Maxa NBL" />
      </a>

      <div class="matchItem__score">
        <div class="matchItem__score-value">- : -</div>
      </div>

      <div class="matchItem__buttons">
        <a href="#" class="button-dark">VSTUPENKY</a>
        <a href="#" class="button-dark-outline">PREVIEW</a>
      </div>
    </div>
    {% endfor %}
  </div>
</section>
