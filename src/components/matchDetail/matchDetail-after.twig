      <div class="matchDetail__score-center">
        <div class="matchDetail__result">98 : 81</div>

        <div class="text-md">1. kolo | Základní část</div>
        <div class="text-md fw-bold">SOB 24. 10. 2026 18:00</div>

        <a href="#" class="d-flex justify-content-center mt-3" target="_blank">
          <img
