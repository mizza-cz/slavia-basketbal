<section class="players-section">
  <div class="tab-content">
    <div class="tab-pane in active show" id="players">
      <div class="d-grid gap-lg-12 gap-10">
        <div class="d-grid gap-lg-8 gap-6">
          <h2 class="h3">ROZEHRÁVAČ</h2>
          <div
            class="row g-5 row-cols-sm-2 row-cols-1 row-cols-md-3 row-cols-lg-5"
          >
            {% for i in 1..4 %}
            <div class="col">
              <a href="#" class="playerCard">
                <div class="playerCard__img">
                  <img src="images/content/player.png" alt="hrac" />
                </div>
                <div class="playerCard__content">
                  <div class="playerCard__num">7</div>
                  <h3 class="h5 mb-2">DAVID BÖHM</h3>
                  <div class="text-lg">25 let</div>
                </div>
              </a>
            </div>
            {% endfor %}
          </div>
        </div>
        <div class="d-grid gap-lg-8 gap-6">
          <h2 class="h3">PIVOT</h2>
          <div
            class="row g-5 row-cols-sm-2 row-cols-1 row-cols-md-3 row-cols-lg-5"
          >
            {% for i in 1..3 %}
            <div class="col">
              <a href="#" class="playerCard">
                <div class="playerCard__img">
                  <img src="images/content/player.png" alt="hrac" />
                </div>
                <div class="playerCard__content">
                  <div class="playerCard__num">7</div>
                  <h3 class="h5 mb-2">DAVID BÖHM</h3>
                  <div class="text-lg">25 let</div>
                </div>
              </a>
            </div>
            {% endfor %}
          </div>
        </div>
        <div class="d-grid gap-lg-8 gap-6">
          <h2 class="h3">KŘÍDLO</h2>
          <div
            class="row g-5 row-cols-sm-2 row-cols-1 row-cols-md-3 row-cols-lg-5"
          >
            {% for i in 1..5 %}
            <div class="col">
              <a href="#" class="playerCard">
                <div class="playerCard__img">
                  <img src="images/content/player.png" alt="hrac" />
                </div>
                <div class="playerCard__content">
                  <div class="playerCard__num">7</div>
                  <h3 class="h5 mb-2">DAVID BÖHM</h3>
                  <div class="text-lg">25 let</div>
                </div>
              </a>
            </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
    <div class="tab-pane fade" id="staff">
      <div class="row g-5 row-cols-sm-2 row-cols-1 row-cols-md-3 row-cols-lg-5">
        {% for i in 1..3 %}
        <div class="col">
          <a href="#" class="playerCard">
            <div class="playerCard__img">
              <img src="images/content/player.png" alt="hrac" />
            </div>
            <div class="playerCard__content">
              <h3 class="h5 mb-2">Eduard Kotásek</h3>
              <div class="text-lg">Asistent trenéra</div>
            </div>
          </a>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
