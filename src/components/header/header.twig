<header class="header">
  <div class="container-full">
    <div class="header__inner">
       <button
        class="header__menu-btn"
        type="button"
        aria-label="Otevřít menu"
        aria-expanded="false"
        aria-controls="main-menu"
        data-menu-open
      >
        <span></span>
        <span></span>
        <span></span>
      </button>

      <a href="/" class="header__logo" aria-label="Slavia Praha">
        <img
          class="object-fit-contain"
          src="images/ico/header-logo.svg"
          width="70"
          height="66"
          alt=""
        />
      </a>

      <a href="#" class="button-light-outline button-lg"> Vstupenky </a>
    </div>
  </div>

  <div class="headerMenu" id="main-menu" aria-hidden="true">
    <div class="headerMenu__bg"></div>

    <div class="headerMenu__inner">
      <button
        class="headerMenu__close"
        type="button"
        aria-label="Zavřít menu"
        data-menu-close
      >
        <span></span>
        <span></span>
      </button>

      <div class="headerMenu__content">
        <div class="headerMenu__teams">
          <div class="headerMenu__group is-open">
            <button
              class="headerMenu__group-btn"
              type="button"
              aria-expanded="true"
            >
              A-TÝM
              <span class="headerMenu__chevron"></span>
            </button>

            <ul class="headerMenu__submenu">
              <li><a href="#">Soupiska</a></li>
              <li><a href="#">Zápasy</a></li>
              <li><a href="#">Tabulka</a></li>
              <li><a href="#">Statistiky</a></li>
            </ul>
          </div>

          <div class="headerMenu__group">
            <button
              class="headerMenu__group-btn"
              type="button"
              aria-expanded="false"
            >
              B-TÝM
              <span class="headerMenu__chevron"></span>
            </button>

            <ul class="headerMenu__submenu">
              <li><a href="#">Soupiska</a></li>
              <li><a href="#">Zápasy</a></li>
              <li><a href="#">Tabulka</a></li>
              <li><a href="#">Statistiky</a></li>
            </ul>
          </div>
        </div>

        <nav class="headerMenu__nav" aria-label="Hlavní navigace">
          <ul>
            <li><a href="#">Články</a></li>
            <li><a href="#">Fotogalerie</a></li>
            <li><a href="#">Mládež</a></li>
            <li><a href="#">Kariéra</a></li>
            <li><a href="#">Partneři</a></li>
            <li><a href="#">Kontakty</a></li>
          </ul>
        </nav>

        <div class="headerMenu__right">
          <div class="headerMenu__socials">
            <a href="#" aria-label="Instagram">
              <img src="images/ico/instagram.svg" alt="" />
            </a>
            <a href="#" aria-label="Facebook">
              <img src="images/ico/facebook.svg" alt="" />
            </a>
            <a href="#" aria-label="TikTok">
              <img src="images/ico/tiktok.svg" alt="" />
            </a>
            <a href="#" aria-label="LinkedIn">
              <img src="images/ico/linkedin.svg" alt="" />
            </a>
            <a href="#" aria-label="X">
              <img src="images/ico/twitter.svg" alt="" />
            </a>
          </div>

          <a href="#" class="button-light-outline button-lg mt-10">
            Vstupenky
          </a>
        </div>
      </div>
    </div>
  </div>
</header>
