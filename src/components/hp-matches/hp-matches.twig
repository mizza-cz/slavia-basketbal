<section class="hp-matches">
  <div class="container-full">
    <div class="hp-matches__inner">
      <div class="hp-matches__list">
        <!-- Finished match -->
        <article class="match-card match-card--finished">
          <div class="match-card__team match-card__team--home">
            <img
              class="match-card__logo"
              src="images/content/slavia.png"
              alt="Slavia Praha"
            />
          </div>

          <div class="match-card__content">
            <div class="mb-4">STŘ 21. 10. 2026 17:30</div>

            <div class="mb-8">
              <strong>Slavia Praha</strong>
              <div>Sršni Písek</div>
            </div>

            <div class="match-card__score">87 : 81</div>

            <a href="#" class="button-dark-outline"> ČLÁNEK </a>
          </div>

          <div class="match-card__team match-card__team--away">
            <img
              class="match-card__logo"
              src="images/content/pisek.png"
              alt="Sršni Písek"
            />
          </div>
        </article>

        <!-- Upcoming match -->
        <article class="match-card match-card--upcoming">
          <div class="match-card__team match-card__team--home">
            <img
              class="match-card__logo"
              src="images/content/slavia.png"
              alt="Slavia Praha"
            />
          </div>

          <div class="match-card__content">
            <div class="mb-4">SOB 24. 10. 2026 18:00</div>

            <div class="mb-8">
              <strong>Slavia Praha</strong>
              <div>BK Pardubice</div>
            </div>

            <div class="match-card__score">- : -</div>

            <div class="match-card__actions">
              <a href="#" class="button-dark"> VSTUPENKY </a>

              <a href="#" class="button-dark-outline"> PREVIEW </a>
            </div>
          </div>

          <div class="match-card__team match-card__team--away">
            <img
              class="match-card__logo"
              src="images/content/pard.png"
              alt="BK KVIS Pardubice"
            />
          </div>
        </article>
      </div>

      <a href="#" class="hp-matches__more">
        <span class="hp-matches__more-icon">→</span>
        <span class="hp-matches__more-text">DALŠÍ ZÁPASY</span>
      </a>
    </div>
  </div>
</section>
